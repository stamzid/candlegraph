# Copy to .env and adjust. Everything has a working default for the local compose
# stack except GRAPH_API_KEY, which ingestion needs.
# Free key: https://thegraph.com/studio/apikeys/

# --- Data source -----------------------------------------------------------
GRAPH_API_KEY=
# Uniswap v3 mainnet is the default subgraph id.
# SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
# Explicit endpoint; overrides the gateway URL when set.
# TRANSPORT_URL=
# SUBGRAPH_PAGE_SIZE=100
# SUBGRAPH_MAX_PAGES=1000
# SUBGRAPH_TIMEOUT_SECONDS=30
# SUBGRAPH_MAX_TRIES=5

# --- Database --------------------------------------------------------------
# Local compose defaults. Replace them for any shared or deployed environment.
DB_HOST=postgres
DB_PORT=5432
DB_USER=candlegraph
DB_PASS=candlegraph
DB_NAME=candlegraph
DB_SCHEMA=candlegraph
# Full URL overrides the DB_* values when set.
# DATABASE_URL=postgresql://user:pass@host:5432/db
MIN_DB_CONNECTIONS=2
MAX_DB_CONNECTIONS=10

# --- Ingestion -------------------------------------------------------------
TOKENS_FILE=config/tokens.yaml
LOOKBACK_DAYS=7
DATA_POLL_INTERVAL=300
# false = delete rows older than LOOKBACK_DAYS after each run
RETAIN_HISTORY=true
# false = serve the API only
INGEST_ENABLED=true

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Local compose only ----------------------------------------------------
# Published host ports. Change these to run two checkouts side by side.
# POSTGRES_HOST_PORT=5432
# APP_HOST_PORT=8000
