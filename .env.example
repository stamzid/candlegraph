# Copy to .env and adjust. Everything has a working default for the local compose
# stack except GRAPH_API_KEY, which ingestion needs.
# Free key: https://thegraph.com/studio/apikeys/

# --- Data source -----------------------------------------------------------
GRAPH_API_KEY=
# Uniswap v3 mainnet is the default subgraph id.
# SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
# Explicit endpoint; overrides the gateway URL when set.
# TRANSPORT_URL=
# SUBGRAPH_PAGE_SIZE=100
# SUBGRAPH_MAX_PAGES=1000
# SUBGRAPH_TIMEOUT_SECONDS=30
# SUBGRAPH_MAX_TRIES=5

# --- Database --------------------------------------------------------------
# Local compose defaults. Replace them for any shared or deployed environment.
DB_HOST=postgres
DB_PORT=5432
DB_USER=candlegraph
DB_PASS=candlegraph
DB_NAME=candlegraph
DB_SCHEMA=candlegraph
# Full URL overrides the DB_* values when set.
# DATABASE_URL=postgresql://user:pass@host:5432/db
MIN_DB_CONNECTIONS=2
MAX_DB_CONNECTIONS=10

# --- Ingestion -------------------------------------------------------------
TOKENS_FILE=config/tokens.yaml
# Only bounds the first fetch for a token with no stored rows. Nothing is
# ever deleted: stored history feeds the analytics and backtesting phases.
LOOKBACK_DAYS=7
DATA_POLL_INTERVAL=300
# false = the API serves only. The compose stack sets this false for the API
# container and runs ingestion in the separate `worker` service.
INGEST_ENABLED=true
# false = skip pool-level data. Pools are the only source of transaction
# counts and per-pair volume.
INGEST_POOLS=true
# Top pools by TVL to track per token, per side of the pair. 0 freezes the
# pool set without stopping ingestion of pools already stored.
POOLS_PER_TOKEN=3

# --- Data quality ----------------------------------------------------------
# Coverage below this fraction flags a token in `candlegraph report`. Hours
# with no swaps legitimately have no row, so this is never 1.0.
MIN_EXPECTED_COVERAGE=0.80

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Local compose only ----------------------------------------------------
# Published host ports. Change these to run two checkouts side by side.
# POSTGRES_HOST_PORT=5432
# APP_HOST_PORT=8000
