# Copy to .env and adjust. Everything has a working default for the local compose
# stack except GRAPH_API_KEY, which ingestion needs.
# Free key: https://thegraph.com/studio/apikeys/

# --- Data source -----------------------------------------------------------
GRAPH_API_KEY=
# Uniswap v3 mainnet is the default subgraph id.
# SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
# Explicit endpoint; overrides the gateway URL when set.
# TRANSPORT_URL=
# SUBGRAPH_PAGE_SIZE=100
# SUBGRAPH_MAX_PAGES=1000
# SUBGRAPH_TIMEOUT_SECONDS=30
# SUBGRAPH_MAX_TRIES=5

# --- Database --------------------------------------------------------------
# Local compose defaults. Replace them for any shared or deployed environment.
DB_HOST=postgres
DB_PORT=5432
DB_USER=candlegraph
DB_PASS=candlegraph
DB_NAME=candlegraph
DB_SCHEMA=candlegraph
# Full URL overrides the DB_* values when set.
# DATABASE_URL=postgresql://user:pass@host:5432/db
MIN_DB_CONNECTIONS=2
MAX_DB_CONNECTIONS=10

# --- Ingestion -------------------------------------------------------------
TOKENS_FILE=config/tokens.yaml
# Only bounds the first fetch for a token with no stored rows. Nothing is
# ever deleted: stored history feeds the analytics and backtesting phases.
LOOKBACK_DAYS=7
DATA_POLL_INTERVAL=300
# false = the API serves only. The compose stack sets this false for the API
# container and runs ingestion in the separate `worker` service.
INGEST_ENABLED=true
# false = skip pool-level data. Pools are the only source of transaction
# counts and per-pair volume.
INGEST_POOLS=true
# Top pools by TVL to track per token, per side of the pair. 0 freezes the
# pool set without stopping ingestion of pools already stored.
POOLS_PER_TOKEN=3

# --- Data quality ----------------------------------------------------------
# Coverage below this fraction flags a token in `candlegraph report`. Hours
# with no swaps legitimately have no row, so this is never 1.0.
MIN_EXPECTED_COVERAGE=0.80

# --- Analytics -------------------------------------------------------------
# Annual risk-free rate for Sharpe ratios and mean-variance optimisation,
# as a decimal fraction: 0.04 means 4% a year. The UI takes percent instead
# and converts; trading costs are the only thing quoted in basis points.
RISK_FREE_RATE=0.0
# Width of one analytics bar, for annualising rates.
ANALYTICS_INTERVAL_HOURS=1
# Trailing window the analytics commands default to.
ANALYTICS_LOOKBACK_DAYS=90
# Rolling mean / volatility lookback, in bars.
ROLLING_WINDOW=24
# Backtest cost assumptions, per side, in basis points.
BACKTEST_FEE_BPS=30
BACKTEST_SLIPPAGE_BPS=5

# --- Risk ------------------------------------------------------------------
# Where the risk-free rate comes from: `constant` uses RISK_FREE_RATE. A
# Tavily-backed source is planned, not built (docs/analytics/risk/DESIGN.md).
RISK_FREE_RATE_SOURCE=constant
# Annual inflation rate, for the real (inflation-adjusted) rate the risk
# report prints beside the nominal one.
INFLATION_RATE=0.0
# Value at Risk: confidence level and horizon in bars. 0.95 over 24 hourly
# bars is a one-day 95% VaR.
RISK_CONFIDENCE=0.95
RISK_HORIZON_BARS=24
# VaR estimator: historical, parametric, or cornish_fisher.
RISK_VAR_METHOD=historical
# Benchmark for splitting a token's risk into systematic (market) and
# idiosyncratic (token-specific) parts. Leave empty to skip the split.
RISK_BENCHMARK=WETH

# --- Knowledge: embeddings ---------------------------------------------------
# Provider: ollama (local, default), openai (hosted), fake (development).
# One active model per deployment; changing EMBEDDING_MODEL makes every
# stored vector stale, and `make reembed` re-encodes them (resumable).
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
# Fixed by the column type halfvec(1024). The model must produce exactly
# this many dimensions (or set EMBEDDING_TRUNCATE=true for a Matryoshka model).
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TRUNCATE=false
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=120
# The ollama compose service; `make up-knowledge` starts it and pulls the model.
OLLAMA_URL=http://ollama:11434
# Only for EMBEDDING_PROVIDER=openai (text-embedding-3-large at 1024 dims).
# OPENAI_API_KEY=

# --- Knowledge: Tavily news search -------------------------------------------
# The news source for signal explanations. Free tier ~1,000 credits/month;
# a basic search costs 1 credit. Without a key the pipeline refuses to run
# and everything else still works. Never commit a real key.
# TAVILY_API_KEY=
# The budget guard's caps: the monthly plan, a daily smoothing cap, and a
# reserve held back for manual searches (the pipeline treats it as spent).
TAVILY_MONTHLY_CREDITS=1000
TAVILY_DAILY_CREDITS=40
TAVILY_RESERVE_CREDITS=50
# basic (1 credit) or advanced (2 credits); the query is narrow, basic suffices.
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=8
TAVILY_TIMEOUT_SECONDS=30
TAVILY_MAX_TRIES=3
# How far before the bar a news search looks, in hours.
KNOWLEDGE_SEARCH_WINDOW_HOURS=24

# --- Agents ----------------------------------------------------------------
# Where agent reports go: comma-separated subset of log, ledger, file,
# webhook, github. `ledger` is the agent_run table (`candlegraph agent-runs`).
AGENT_REPORT_SINKS=log,ledger
# Directory for the `file` sink, relative to the repo root unless absolute.
# AGENT_REPORT_DIR=reports
# Slack-compatible endpoint for the `webhook` sink.
# AGENT_WEBHOOK_URL=
# owner/repo for the `github` sink (issues at WARNING or worse); defaults to
# the checkout's origin.
# AGENT_GITHUB_REPO=
# Optional: narrate reports with a Claude model (needs `uv sync --extra llm`).
# The model only writes the summary paragraph; findings and status are
# computed, never generated. Unset = deterministic template.
# AGENT_LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Run observer. Seconds between runs in `candlegraph agents`; 0 disables.
OBSERVER_INTERVAL=900
# Poll intervals without a successful ingest before the data is stale
# (WARNING), and twice that is CRITICAL.
OBSERVER_STALE_INTERVALS=3
# Consecutive failed ingest runs that is CRITICAL.
OBSERVER_FAILURE_STREAK=3
# Recent window and the baseline window immediately before it.
OBSERVER_DRIFT_WINDOW_HOURS=24
OBSERVER_BASELINE_DAYS=7
# A window with fewer bars than this is "not enough data", never drift.
OBSERVER_MIN_BARS=12
# Ratios of recent to baseline medians that count as drift.
OBSERVER_VOLUME_DRIFT_RATIO=4.0
OBSERVER_VOLATILITY_DRIFT_RATIO=3.0
OBSERVER_RUN_DRIFT_RATIO=3.0
# A contiguous gap this long is suspicious on a liquid token only; a thin
# token with no swaps legitimately has no rows.
OBSERVER_SUSPICIOUS_GAP_HOURS=6
OBSERVER_LIQUID_VOLUME_USD=100000

# CI janitor. Make targets to run, in order. Only `fmt-check` and `lint`
# have a mechanical fixer (`make fmt`); the rest are reported.
JANITOR_CHECKS=fmt-check,lint,typecheck,test-unit
# Push a branch and open a draft PR when a fix changed tracked files. Needs
# `gh` and a token; the janitor workflow sets this true.
JANITOR_OPEN_PR=false
JANITOR_BASE_BRANCH=main
JANITOR_TIMEOUT_SECONDS=900
JANITOR_OUTPUT_LINES=40
# Seconds between janitor runs in `candlegraph agents`; 0 disables. The
# compose container has no git checkout, so the schedule there is 0 and the
# real one is .github/workflows/janitor.yml.
JANITOR_INTERVAL=0
# Checkout the janitor operates on; defaults to this repository.
# JANITOR_REPO_ROOT=

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
UI_HOST=0.0.0.0
UI_PORT=8501
LOG_LEVEL=INFO
# true = write every successful GET /status to the access log. Off by default:
# the compose health probe is the only regular caller, and a 503 is logged
# regardless.
LOG_HEALTH_PROBES=false

# --- Local compose only ----------------------------------------------------
# Published host ports. Change these to run two checkouts side by side.
# POSTGRES_HOST_PORT=5432
# APP_HOST_PORT=8000
# UI_HOST_PORT=8501
