# Example environment for the foundation service.
# The DB values below are local-development defaults for the Docker Postgres
# container only. Replace them for any shared or deployed environment.

TRANSPORT_URL=https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3

DB_HOST=foundation_postgres
DB_PORT=5432
DB_USER=foundation
DB_PASS=foundation
DB_NAME=foundation
DB_SCHEMA=foundation

MINIMUM_DB_CONNECTIONS=16
MAXIMUM_DB_CONNECTIONS=1024

# Variable names below match what foundation/settings.py currently reads.
LOOBACK_DAYS=7
DATA_POLL_INTERVAL=300
# Unset = delete data older than the lookback window; any value = keep it.
# PERSISTANCE_MODE=keep
